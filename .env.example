# Copy to .env — never commit .env

# Formspree (forms.formspree.io) — create form, copy ID
PUBLIC_FORMSPREE_ID=

# Google Analytics 4 (optional — enables the cookie banner and conversion events;
# see docs/ANALYTICS.md)
PUBLIC_GA_ID=

# PostHog (optional — project API key from Project Settings. Either this or
# PUBLIC_GA_ID enables the cookie banner; set both to send events to both.)
PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com — set only for EU or self-hosted.
PUBLIC_POSTHOG_HOST=

# Stripe Payment Links (create in Stripe Dashboard → Payment Links)
PUBLIC_STRIPE_PAYMENT_URL=
PUBLIC_STRIPE_LINK_HCA_BLENDED=
PUBLIC_STRIPE_LINK_CORE_BASIC=
PUBLIC_STRIPE_LINK_CPR=
PUBLIC_STRIPE_LINK_CE=

# ClassManager.pro embed URL (alternative to Stripe links)
PUBLIC_CLASSMANAGER_EMBED_URL=

# Payment provider hint: stripe | classmanager
PUBLIC_PAYMENT_PROVIDER=stripe

# Firecrawl (local migration only — not needed at runtime)
# FIRECRAWL_API_KEY=
