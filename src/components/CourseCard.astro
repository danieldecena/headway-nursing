---
import type { Course } from '../data/courses';
import { formatPrice } from '../data/courses';

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
  <div class="flex items-start justify-between gap-2">
    <h3 class="text-lg font-semibold text-brand-900">
      <a href={`/courses/${course.slug}`} class="hover:text-brand-600">{course.title}</a>
    </h3>
    {!course.available && (
      <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">
        Unavailable
      </span>
    )}
  </div>
  <p class="mt-2 flex-1 text-sm text-slate-600">{course.shortDescription}</p>
  <div class="mt-4 flex items-end justify-between gap-4">
    <p class="text-lg font-bold text-brand-700">
      {formatPrice(course.price, course.priceNote)}
    </p>
    <a
      href={`/courses/${course.slug}#register`}
      class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
    >
      Register
    </a>
  </div>
</article>
