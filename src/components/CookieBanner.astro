---
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{gaId && (
  <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-slate-200 bg-white p-4 shadow-lg" role="dialog" aria-label="Cookie consent">
    <div class="mx-auto flex max-w-4xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-slate-600">
        We use cookies for analytics to improve our site.
        <a href="/privacy" class="text-brand-600 underline">Privacy Policy</a>
      </p>
      <button
        id="cookie-accept"
        type="button"
        class="shrink-0 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
      >
        Accept
      </button>
    </div>
  </div>
  <script is:inline define:vars={{ gaId }}>
    if (!localStorage.getItem('cookie-consent') && gaId) {
      document.getElementById('cookie-banner')?.classList.remove('hidden');
    }
    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', '1');
      document.getElementById('cookie-banner')?.classList.add('hidden');
    });
  </script>
)}
