---
// PostHog stub queue. Creates window.posthog so captures made before consent
// are held in memory; CookieBanner calls posthog.init() once the visitor
// accepts, which loads the real SDK and replays the queue. A decline never
// calls init(), so the queue is discarded and nothing reaches the network.
// is:inline keeps Astro from processing the script, which would otherwise
// raise TypeScript errors about window.posthog.
const apiKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const isDev = import.meta.env.DEV;
---

