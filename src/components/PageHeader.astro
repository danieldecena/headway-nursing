---
interface Props {
  class?: string;
}

// Extra utilities lead the string so the emitted class order matches the
// hand-written markup these headings replaced.
const { class: extra } = Astro.props;
const headingClass = [extra, 'text-4xl font-bold text-brand-900 md:text-5xl'].filter(Boolean).join(' ');
---

<h1 class={headingClass}>
  <slot />
</h1>
