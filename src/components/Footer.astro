---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-brand-900 text-slate-300">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-semibold text-white">{site.name}</p>
      <p class="mt-2 text-sm">{site.address.full}</p>
      <p class="mt-2 text-sm">
        <a href={`tel:${site.phone.office}`} class="hover:text-white">{site.phone.office}</a>
        · <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
      </p>
      <p class="mt-1 text-xs text-slate-400">{site.hours}</p>
    </div>
    <div>
      <p class="font-semibold text-white">Quick links</p>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href="/courses" class="hover:text-white">Courses</a></li>
        <li><a href="/schedule" class="hover:text-white">Schedule</a></li>
        <li><a href="/virtual-learning" class="hover:text-white">Virtual Learning</a></li>
        <li><a href="/student-login" class="hover:text-white">Student Login</a></li>
        <li><a href="/hca-exam" class="hover:text-white">HCA Exam Info</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-white">Legal</p>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href="/privacy" class="hover:text-white">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-white">Terms of Service</a></li>
        <li><a href="/refund-policy" class="hover:text-white">Refund Policy</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-800 px-4 py-4 text-center text-xs text-slate-400">
    &copy; {year} {site.name}. DSHS-Approved Training Provider.
  </div>
</footer>
