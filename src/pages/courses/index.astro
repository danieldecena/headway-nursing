---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import PageHeader from '../../components/PageHeader.astro';
import CourseCard from '../../components/CourseCard.astro';
import { courses, registrationFee, registrationFeeNote } from '../../data/courses';
import type { Course } from '../../data/courses';

const groups: { category: Course['category']; label: string; blurb: string }[] = [
  { category: 'hca', label: 'Home Care Aide training', blurb: 'The state-required 75-hour and core programs that qualify you for the HCA exam.' },
  { category: 'specialty', label: 'Specialty training', blurb: 'Add dementia and mental health specialties to your certification.' },
  { category: 'certification', label: 'Certifications & delegation', blurb: 'Nurse delegation, CPR/First Aid, and other required certificates.' },
  { category: 'continuing-ed', label: 'Continuing education', blurb: 'Keep your certification current.' },
].map((g) => ({ ...g, items: courses.filter((c) => c.category === g.category) }))
  .filter((g) => g.items.length > 0) as ({ category: Course['category']; label: string; blurb: string; items: Course[] })[];
---

<BaseLayout
  title="Courses"
  description="DSHS-approved HCA training, specialty certifications, and continuing education courses in Seattle, WA."
>
  <PageShell width="xl">
    <PageHeader>Courses & Pricing</PageHeader>
    <p class="mt-2 max-w-2xl text-slate-600">
      All courses are taught by Washington State DSHS-approved instructors. Payment accepted via cash,
      check, or online.
    </p>

    <div class="mt-6 flex items-baseline gap-3 rounded-lg border border-brand-200 bg-brand-50 p-4 text-brand-900">
      <span class="text-xl font-bold">${registrationFee}</span>
      <span class="text-sm"><strong>registration fee</strong> — {registrationFeeNote}</span>
    </div>

    {groups.map((group) => (
      <section class="mt-12">
        <h2 class="text-2xl font-semibold text-brand-800">{group.label}</h2>
        <p class="mt-1 text-sm text-slate-600">{group.blurb}</p>
        <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {group.items.map((course) => (
            <CourseCard course={course} />
          ))}
        </div>
      </section>
    ))}
  </PageShell>
</BaseLayout>
