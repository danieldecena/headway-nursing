---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegisterSection from '../../components/RegisterSection.astro';
import { courses, getCourse, formatPrice } from '../../data/courses';

export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug } }));
}

const { slug } = Astro.params;
const course = getCourse(slug!);

if (!course) {
  return Astro.redirect('/courses');
}
---

<BaseLayout title={course.title} description={course.shortDescription}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav class="text-sm text-slate-500">
      <a href="/courses" class="hover:text-brand-600">Courses</a>
      <span aria-hidden="true"> / </span>
      <span>{course.title}</span>
    </nav>

    <header class="mt-4">
      {!course.available && (
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800">
          Currently unavailable
        </span>
      )}
      <h1 class="mt-2 text-3xl font-bold text-brand-900">{course.title}</h1>
      <p class="mt-2 text-lg text-slate-600">{course.shortDescription}</p>
    </header>

    <dl class="mt-8 grid gap-4 rounded-xl border border-slate-200 bg-white p-6 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium uppercase text-slate-500">Price</dt>
        <dd class="mt-1 text-xl font-bold text-brand-700">{formatPrice(course.price, course.priceNote)}</dd>
      </div>
      {course.duration && (
        <div>
          <dt class="text-xs font-medium uppercase text-slate-500">Duration</dt>
          <dd class="mt-1 font-medium text-slate-800">{course.duration}</dd>
        </div>
      )}
      <div>
        <dt class="text-xs font-medium uppercase text-slate-500">Format</dt>
        <dd class="mt-1 font-medium text-slate-800">{course.format}</dd>
      </div>
    </dl>

    <div class="prose prose-slate mt-8 max-w-none">
      <p>{course.description}</p>
      {course.highlights && (
        <ul>
          {course.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )}
    </div>

    <div class="mt-10">
      {course.available ? (
        <RegisterSection courseTitle={course.title} courseSlug={course.slug} />
      ) : (
        <section class="rounded-xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-xl font-bold text-brand-900">This course is currently unavailable</h2>
          <p class="mt-2 text-slate-600">
            Contact us for waitlist options or alternative blended training.
          </p>
          <a href="/contact" class="mt-4 inline-block rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700">
            Contact us
          </a>
        </section>
      )}
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: course.title,
    description: course.description,
    provider: { '@type': 'Organization', name: 'Headway Nursing Services', url: 'https://www.headwaynursing.org' },
    ...(course.available && course.price && {
      offers: {
        '@type': 'Offer',
        price: course.price,
        priceCurrency: 'USD',
      },
    }),
  })} />
</BaseLayout>
