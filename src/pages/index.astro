---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import Card from '../components/Card.astro';
import { courses } from '../data/courses';
import { site } from '../data/site';
import { testimonials } from '../data/testimonials';

const available = courses.filter((c) => c.available);
const featured = available.slice(0, 4);
const lead = testimonials[0];
const heroFacts = [
  { value: `${available.length} courses`, label: 'HCA, specialty certification and continuing education' },
  { value: 'DSHS-approved', label: 'Instructor and curriculum approved by Washington State' },
  { value: 'Online + in person', label: 'Blended classes with hands-on skills days' },
  { value: site.phone.office, label: site.hours },
];
---

<BaseLayout title={site.name}>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 md:grid-cols-[1.15fr_1fr] md:items-center md:py-28">
      <div>
        <p class="text-sm font-medium uppercase tracking-widest text-brand-200">
          Washington State DSHS-approved training provider · Seattle
        </p>
        <h1 class="mt-4 text-4xl font-bold leading-tight md:text-6xl">
          {site.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-brand-100">
          Start a fulfilling career in healthcare. Home Care Aide training, specialty
          certifications, and continuing education — in-person and virtual.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a href="/courses" class="rounded-lg bg-accent-500 px-8 py-4 text-base font-semibold text-white shadow hover:bg-accent-600">
            View Courses
          </a>
          <a href="/schedule" class="font-semibold text-white underline decoration-brand-200/60 underline-offset-4 hover:decoration-white">
            Class Schedule
          </a>
          <a href="/contact" class="font-semibold text-white underline decoration-brand-200/60 underline-offset-4 hover:decoration-white">
            Contact Us
          </a>
        </div>
      </div>

      <dl class="rounded-xl border border-brand-700 bg-brand-800 p-8">
        {heroFacts.map((fact) => (
          <div class="border-b border-brand-700 py-4 first:pt-0 last:border-0 last:pb-0">
            <dt class="text-2xl font-bold text-white">{fact.value}</dt>
            <dd class="mt-1 text-sm text-brand-100">{fact.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="border-b border-amber-200 bg-amber-50">
    <div class="mx-auto max-w-6xl px-4 py-4">
      <p class="text-sm text-amber-900">
        <strong>2026 update:</strong> Our office is now at {site.address.full}.
        <a href="/whats-new" class="ml-1 font-semibold underline hover:text-amber-950">HCA 365-day timeline update →</a>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-brand-900">Featured courses</h2>
    <p class="mt-2 text-slate-600">Washington State approved training for caregivers and home care aides.</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {featured.map((course) => (
        <CourseCard course={course} />
      ))}
    </div>
    <p class="mt-8 text-center">
      <a href="/courses" class="font-semibold text-brand-700 hover:text-brand-900">View all courses →</a>
    </p>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl font-bold text-brand-900">Why Headway Nursing?</h2>
          <ul class="mt-4 space-y-3 text-slate-600">
            <li class="flex gap-2"><span class="font-bold text-accent-600">✓</span> DSHS-approved instructor and curriculum</li>
            <li class="flex gap-2"><span class="font-bold text-accent-600">✓</span> 20+ years experience in long-term care</li>
            <li class="flex gap-2"><span class="font-bold text-accent-600">✓</span> Blended and virtual learning options</li>
            <li class="flex gap-2"><span class="font-bold text-accent-600">✓</span> Certificates via email, mail, or in-person</li>
          </ul>
        </div>
        <Card tone="muted">
          <h3 class="font-semibold text-brand-900">Quickly increase your earning potential</h3>
          <p class="mt-2 text-sm text-slate-600">
            Home Care Aides are in demand across long-term care facilities, home health, and hospice.
            Our program prepares you with the knowledge and hands-on experience employers need.
          </p>
          <div class="mt-4 flex flex-wrap gap-3 text-sm">
            <a href="/hca-exam" class="font-semibold text-brand-700 hover:text-brand-900">HCA exam steps →</a>
            <a href="/student-login" class="font-semibold text-accent-700 hover:text-accent-900">Student login →</a>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <figure class="mx-auto max-w-3xl px-4 text-center">
      <blockquote class="font-serif text-xl leading-relaxed text-slate-700 before:content-['\201C'] after:content-['\201D']">
        {lead.quote.split('. ').slice(0, 2).join('. ')}.
      </blockquote>
      <figcaption class="mt-6 text-sm text-slate-500">
        <span class="font-semibold text-brand-900">{lead.name}</span> · {lead.role}
      </figcaption>
      <a href="/testimonials" class="mt-6 inline-block font-semibold text-brand-700 hover:text-brand-900">
        Read more student stories →
      </a>
    </figure>
  </section>

  <section class="bg-brand-900 py-16 text-white">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="text-2xl font-bold">Ready to start your caregiver training?</h2>
      <p class="mt-3 text-brand-100">
        Classes run year-round in Seattle and online. Ask about the next available start date.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/courses" class="rounded-lg bg-accent-500 px-8 py-4 text-base font-semibold text-white shadow hover:bg-accent-600">
          View Courses
        </a>
        <a href={`tel:${site.phone.office}`} class="rounded-lg border border-brand-200 px-8 py-4 text-base font-semibold text-white hover:bg-brand-800">
          Call {site.phone.office}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
