---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PageHeader from '../components/PageHeader.astro';
import { initials, testimonials } from '../data/testimonials';
---

<BaseLayout title="Testimonials" description="Student testimonials for Headway Nursing Services HCA training in Seattle.">
  <PageShell width="lg">
    <PageHeader>Testimonials</PageHeader>
    <p class="mt-2 text-slate-600">
      What our students and partners say about Headway Nursing Services.
    </p>

    <div class="mt-12 space-y-12">
      {testimonials.map((person) => (
        <figure class="grid gap-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:grid-cols-[10rem_1fr] sm:gap-8 sm:p-8">
          <div class="mx-auto sm:mx-0">
            {person.photo ? (
              <img
                src={person.photo}
                alt={`${person.name}, ${person.role}`}
                width="160"
                height="160"
                loading="lazy"
                class="h-40 w-40 rounded-xl object-cover"
              />
            ) : (
              <div
                aria-hidden="true"
                class="flex h-40 w-40 items-center justify-center rounded-xl bg-brand-100 font-serif text-4xl font-bold text-brand-700"
              >
                {initials(person.name)}
              </div>
            )}
          </div>
          <div>
            <blockquote class="font-serif text-lg leading-relaxed text-slate-700 before:content-['\201C'] after:content-['\201D']">
              {person.quote}
            </blockquote>
            <figcaption class="mt-4 border-t border-slate-200 pt-4">
              <span class="block font-semibold text-brand-900">{person.name}</span>
              <span class="block text-sm text-slate-500">{person.role}</span>
            </figcaption>
          </div>
        </figure>
      ))}
    </div>
  </PageShell>
</BaseLayout>
