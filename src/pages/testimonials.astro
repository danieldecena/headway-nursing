---
import BaseLayout from '../layouts/BaseLayout.astro';
import { testimonialImages } from '../data/testimonials';
---

<BaseLayout title="Testimonials" description="Student testimonials for Headway Nursing Services HCA training in Seattle.">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-900">Testimonials</h1>
    <p class="mt-2 text-slate-600">
      What our students and partners say about Headway Nursing Services.
    </p>

    <div class="mt-10 space-y-8">
      {testimonialImages.map((src) => (
        <figure class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <img src={src} alt="Student testimonial" class="w-full" loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</BaseLayout>
