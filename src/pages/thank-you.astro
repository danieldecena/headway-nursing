---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Thank You" description="Registration received — Headway Nursing Services" noindex>
  <div class="mx-auto max-w-xl px-4 py-20 text-center">
    <PageHeader>Thank you!</PageHeader>
    <p class="mt-4 text-slate-600">
      Your message has been received. We will contact you within 1–2 business days during office hours
      (Mon–Fri, 9 AM – 3 PM).
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/courses">
        View courses
      </Button>
      <Button href="/" variant="secondary">
        Back to home
      </Button>
    </div>
  </div>
</BaseLayout>
