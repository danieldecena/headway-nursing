---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You" description="Registration received — Headway Nursing Services">
  <div class="mx-auto max-w-xl px-4 py-20 text-center">
    <h1 class="text-3xl font-bold text-brand-900">Thank you!</h1>
    <p class="mt-4 text-slate-600">
      Your message has been received. We will contact you within 1–2 business days during office hours
      (Mon–Fri, 9 AM – 3 PM).
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/courses" class="rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700">
        View courses
      </a>
      <a href="/" class="rounded-lg border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">
        Back to home
      </a>
    </div>
  </div>
</BaseLayout>
