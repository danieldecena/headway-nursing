---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Refund Policy">
  <div class="prose prose-slate mx-auto max-w-3xl px-4 py-12">
    <h1>Refund & Cancellation Policy</h1>
    <p><em>Confirm with Janice before launch — based on current site policies.</em></p>

    <h2>Core Basic Training</h2>
    <p>Notice to cancel required <strong>2 weeks prior</strong> to the first day of class. Must be registered to receive cancellation notice.</p>

    <h2>Registration fee</h2>
    <p>A $50 registration fee covers books and administrative work. Refund eligibility for this fee should be confirmed at registration.</p>

    <h2>General</h2>
    <ul>
      <li>Contact Headway Nursing as soon as possible if you need to cancel or reschedule.</li>
      <li>Refunds for online payments processed through Stripe are subject to verification of cancellation timing.</li>
      <li>No-shows may not be eligible for refund.</li>
    </ul>

    <p><a href="/contact">Contact us</a> with questions about your specific registration.</p>
  </div>
</BaseLayout>
