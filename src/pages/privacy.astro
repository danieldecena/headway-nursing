---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import { site } from '../data/site';
---

<BaseLayout title="Privacy Policy">
  <PageShell prose>
    <h1>Privacy Policy</h1>
    <p><em>Last updated: August 2026.</em></p>

    <p>
      {site.name} ("we," "us") operates {site.url}. This policy explains how we collect, use, and
      protect your information when you register for training, contact us, or use our website.
    </p>

    <h2>Information we collect</h2>
    <ul>
      <li><strong>Registration and contact:</strong> Name, email, phone, course interest, and messages you submit via our forms.</li>
      <li><strong>Payment:</strong> Payment card data is processed by Stripe; we do not store full card numbers on our servers.</li>
      <li><strong>Training records:</strong> Attendance, exam results, and certification data required by DSHS and DOH.</li>
      <li><strong>Analytics:</strong> If enabled, Google Analytics and PostHog collect usage data (pages visited, device type, and which buttons were used). Both load only after you accept cookies.</li>
    </ul>

    <h2>How we use information</h2>
    <ul>
      <li>Process course registrations and payments</li>
      <li>Communicate about schedules, virtual class access, and certificates</li>
      <li>Comply with Washington State training and certification requirements</li>
      <li>Improve our website and services</li>
    </ul>

    <h2>Third-party services</h2>
    <ul>
      <li>Formspree (form processing)</li>
      <li>Stripe (payments)</li>
      <li>Relias Learning (online training modules)</li>
      <li>Google Classroom and RingCentral (virtual classes)</li>
      <li>Google Analytics (optional)</li>
      <li>PostHog (optional)</li>
    </ul>

    <h2>Your rights</h2>
    <p>
      You may request access to or correction of your personal information by contacting us at{' '}
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>

    <h2>Contact</h2>
    <p>{site.name}<br />{site.address.full}<br />{site.email}</p>
  </PageShell>
</BaseLayout>
