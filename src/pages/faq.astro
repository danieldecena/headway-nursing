---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import { faqs } from '../data/faqs';
---

<BaseLayout title="FAQ" description="Frequently asked questions about HCA training and certification at Headway Nursing Services.">
  <PageShell>
    <PageHeader>Frequently Asked Questions</PageHeader>
    <p class="mt-2 text-slate-600">
      Common questions about Home Care Aide certification and training in Washington State.
    </p>

    <dl class="mt-10 space-y-8">
      {faqs.map((item) => (
        <Card>
          <dt class="font-semibold text-brand-900">{item.question}</dt>
          <dd class="mt-3 text-slate-600">{item.answer}</dd>
        </Card>
      ))}
    </dl>
  </PageShell>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  })} />
</BaseLayout>
