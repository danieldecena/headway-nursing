---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faqs';
---

<BaseLayout title="FAQ" description="Frequently asked questions about HCA training and certification at Headway Nursing Services.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-900">Frequently Asked Questions</h1>
    <p class="mt-2 text-slate-600">
      Common questions about Home Care Aide certification and training in Washington State.
    </p>

    <dl class="mt-10 space-y-8">
      {faqs.map((item) => (
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <dt class="font-semibold text-brand-900">{item.question}</dt>
          <dd class="mt-3 text-slate-600">{item.answer}</dd>
        </div>
      ))}
    </dl>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  })} />
</BaseLayout>
