---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="About Us" description="About Headway Nursing Services and Janice Angle, RN — DSHS-approved instructor in Seattle, WA.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-900">About Headway Nursing Services</h1>

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-brand-800">Our Mission</h2>
      <p class="mt-3 text-slate-600">{site.mission}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-brand-800">Our Vision</h2>
      <p class="mt-3 text-slate-600">{site.vision}</p>
    </section>

    <section class="mt-10 rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-semibold text-brand-800">{site.director.name}</h2>
      <p class="text-sm text-teal-700">{site.director.title}</p>
      <p class="mt-4 text-slate-600">{site.director.bio}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-brand-800">Location</h2>
      <address class="mt-3 not-italic text-slate-600">
        {site.address.full}
      </address>
      <p class="mt-2 text-sm text-slate-500">{site.hours}</p>
    </section>
  </div>
</BaseLayout>
