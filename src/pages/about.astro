---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import { site } from '../data/site';
---

<BaseLayout title="About Us" description="About Headway Nursing Services and Janice Angle, RN — DSHS-approved instructor in Seattle, WA.">
  <PageShell>
    <PageHeader>About Headway Nursing Services</PageHeader>

    <section class="mt-8">
      <SectionHeading>Our Mission</SectionHeading>
      <p class="mt-3 text-slate-600">{site.mission}</p>
    </section>

    <section class="mt-10">
      <SectionHeading>Our Vision</SectionHeading>
      <p class="mt-3 text-slate-600">{site.vision}</p>
    </section>

    <Card as="section" class="mt-10">
      <SectionHeading>{site.director.name}</SectionHeading>
      <p class="text-sm text-teal-700">{site.director.title}</p>
      <p class="mt-4 text-slate-600">{site.director.bio}</p>
    </Card>

    <section class="mt-10">
      <SectionHeading>Location</SectionHeading>
      <address class="mt-3 not-italic text-slate-600">
        {site.address.full}
      </address>
      <p class="mt-2 text-sm text-slate-500">{site.hours}</p>
    </section>
  </PageShell>
</BaseLayout>
