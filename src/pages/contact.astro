---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import RegisterSection from '../components/RegisterSection.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Contact Headway Nursing Services in Seattle, WA for HCA training and caregiver certification.">
  <PageShell>
    <PageHeader>Contact Us</PageHeader>
    <p class="mt-2 text-slate-600">{site.hoursNote}</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <Card>
        <h2 class="font-semibold text-brand-900">Office</h2>
        <address class="mt-2 not-italic text-slate-600">
          {site.address.full}
        </address>
        <a href={site.address.mapUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm text-brand-700 hover:underline">
          Get directions →
        </a>
        <p class="mt-4 text-sm text-slate-600">{site.hours}</p>
      </Card>
      <Card>
        <h2 class="font-semibold text-brand-900">Phone & email</h2>
        <ul class="mt-2 space-y-1 text-sm text-slate-600">
          <li>Office: <a href={`tel:${site.phone.office}`} class="text-brand-700">{site.phone.office}</a></li>
          <li>Toll-free: <a href={`tel:${site.phone.tollFree}`} class="text-brand-700">{site.phone.tollFree}</a></li>
          <li>After hours: <a href={`tel:${site.phone.afterHours}`} class="text-brand-700">{site.phone.afterHours}</a></li>
          <li>Email: <a href={`mailto:${site.email}`} class="text-brand-700">{site.email}</a></li>
        </ul>
      </Card>
    </div>

    <div class="mt-8 flex flex-wrap gap-4 text-sm">
      <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">Facebook</a>
      <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">Instagram</a>
      <a href={site.social.twitter} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">Twitter</a>
    </div>

    <div class="mt-10">
      <RegisterSection />
    </div>
  </PageShell>
</BaseLayout>
